    },

    "community": {
      ".read": true,
      "$room": {
        ".read": true,
        ".write": true,
        ".indexOn": ["timestamp", "createdAt"],
        "$messageId": {
          ".read": true,
          ".write": true
        }
      }
    },

    "deletionRequests": {
      ".indexOn": ["createdAt"],
      ".read": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
