    },

    "notifications": {
      ".read": true,
      ".indexOn": ["createdAt"],
      ".write": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

