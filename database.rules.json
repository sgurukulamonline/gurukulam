{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": true,
      ".indexOn": ["role", "isLeader", "communityBlocked", "createdAt"],
      "$uid": {
        ".read": true,
        ".write": "(auth != null && (auth.uid === $uid || auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')) || $uid.beginsWith('ph_') || $uid.beginsWith('admin_')"
      }
    },

    "courses": {
      ".read": true,
      ".indexOn": ["pinOrder", "published", "releaseTime", "createdAt"],
      ".write": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "enrollments": {
      ".read": "auth != null",
      "$uid": {
        ".read": true,
        ".write": "(auth != null && (auth.uid === $uid || auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')) || $uid.beginsWith('ph_') || $uid.beginsWith('admin_')"
      }
    },

    "liveClasses": {
      ".read": true,
      ".indexOn": ["startsAt", "createdAt"],
      ".write": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "dailyWisdom": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "wisdom": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "notifications": {
      ".read": true,
      ".indexOn": ["createdAt"],
      ".write": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "learningPaths": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "community": {
      ".read": true,
      "$room": {
        ".read": true,
        ".indexOn": ["timestamp", "createdAt", "at"],
        "$messageId": {
          ".read": true,
          ".write": "(!newData.exists()) || (newData.hasChildren(['uid', 'name', 'text']) && !newData.hasChild('phone') && !newData.hasChild('phoneNumber') && (root.child('users').child(newData.child('uid').val()).child('communityBlocked').val() != true) && (newData.child('uid').val().beginsWith('ph_') || newData.child('uid').val().beginsWith('admin_') || (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org'))))"
        }
      }
    },

    "deletionRequests": {
      ".indexOn": ["createdAt"],
      ".read": "auth != null && (auth.token.email === 'sgurukulamonline@gmail.com' || auth.token.email === 'reshwanthreddy.gangula@gmail.com' || auth.token.email === 'admin@gurukulam.org' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": true
    }
  }
}
