{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "courses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "liveClasses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "enrollments": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "community": {
      "$room": {
        ".read": true,
        "$msg": {
          ".write": true
        }
      }
    },
    "notifications": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
